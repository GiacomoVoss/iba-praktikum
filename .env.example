# ============================================================
# Umgebungsvariablen – Konfiguration der Anwendung
# ============================================================
# Kopiere diese Datei zu ".env" und passe die Werte an:
#   cp .env.example .env
# ============================================================

# Port, auf dem der Server läuft (Standard: 3000)
PORT=3000

# Geheimer Schlüssel für die JWT-Signierung.
# WICHTIG: Ersetze diesen Wert durch eine lange, zufällige Zeichenkette!
# Beispiel (Linux/Mac): openssl rand -hex 32
JWT_SECRET=ersetze-mich-durch-einen-sicheren-zufallsschluessel

# Gültigkeitsdauer eines JWT-Tokens (z.B. "1h", "2d", "7d")
JWT_EXPIRES_IN=7d
